# The deck editor as a Railway service (08.10.2026): Python + Chromium + puppeteer-core, the generators, the photographs.
# Edits, uploads, re-framed pictures, versions and the published PDF live on the volume mounted at /app/data (see editor-start.sh).
# Railway: RAILWAY_DOCKERFILE_PATH=Dockerfile.editor; the context is filtered by Dockerfile.editor.dockerignore.
FROM python:3.12-slim
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 CHROME_PATH=/usr/bin/chromium
RUN apt-get update && apt-get install -y --no-install-recommends chromium nodejs npm fonts-liberation fonts-dejavu-core ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
RUN pip install --no-cache-dir pillow segno pymupdf numpy
COPY review/pp/package.json review/pp/package-lock.json review/pp/
RUN cd review/pp && npm ci --omit=dev && npm cache clean --force
COPY src ./src
COPY brand ./brand
COPY img ./img
COPY photo ./photo
COPY editor-start.sh ./
RUN mkdir -p review/lb review/pp/team/deck data && python3 src/build-deck-variants.py
ENV DECK_EDITOR_BIND=0.0.0.0 DECK_EDITS=/app/data/deck-edits.json DECK_EDITOR_PUBLISH="python3 src/deck-publish-prod.py"
CMD ["sh", "editor-start.sh"]
